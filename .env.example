# ---------------------------------------------------------------------------
# YunNian 云辇 · 一体化部署的环境变量
#
#   cp .env.example .env   然后填好三个密钥，再 docker compose up -d
#   （compose 会自动读同目录的 .env）
#
# ⚠️ .env 已被 .gitignore 忽略，**不要提交**。真实密钥也别写进
#    docker-compose.yml —— 那个文件是要进仓库的。
# ---------------------------------------------------------------------------

# ① JWT 签名密钥（生产必填）—— 至少 32 字节随机
#    生成：openssl rand -base64 48
YUNNIAN_JWT_SECRET=

# ② 加密主密钥（生产必填）—— 用于加密 kubeconfig / 模型密钥等
#    生成：openssl rand -base64 32
YUNNIAN_MASTER_KEY=

# ③ MySQL root 密码（生产必填）
#    生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# ④ 平台访问端口（默认 8080）
YUNNIAN_PORT=8080

# ⑤ MySQL 应用账号密码（默认 changeme，**生产请改**）
MYSQL_PASSWORD=changeme

# ⑥ 宿主 docker 组的 GID（「自建构建」必需）
#    容器以非 root 运行，必须加入宿主 docker 组才能访问 docker.sock。
#    查法：stat -c %g /var/run/docker.sock      （常见 994 / 999 / 998）
DOCKER_GID=994
